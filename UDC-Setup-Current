#!/bin/bash
# UDC-SETUP v2.2 - Master Setup Script with Fixed Self-Update Logic
# Features: Auto-Update from GitHub (after curl install), Multi-script install, Safety checks
# URL: https://raw.githubusercontent.com/mmedia13/UDC/refs/heads/main/UDC-Setup-Current

# --- Configuration ---
LOG_BASE="/home/logs"
UDC_DIR="$LOG_BASE/UDC"
mkdir -p "$UDC_DIR"
SETUP_LOG="$UDC_DIR/SETUP.log"
SCRIPT_URL="https://raw.githubusercontent.com/mmedia13/UDC/refs/heads/main/UDC-Setup-Current"

# Enable logging to file immediately
exec > >(tee -a "$SETUP_LOG") 2>&1

set -e

# --- Helper Functions ---

log_msg() { echo "[INFO] $(date '+%T'): $1"; }
log_error() { echo "[ERROR] $(date '+%T'): $1" >&2; }

check_root() {
    if [ "$EUID" -ne 0 ]; then
        log_error "This script must be run as root (sudo)."
        echo "Please run: sudo ./UDC-SETUP"
        exit 1
    fi
}

step_header() {
    echo ""
    echo "=========================================="
    echo "      $1"
    echo "=========================================="
}

# --- Step 0: Minimal Dependency Install (FIXED) ---
# We MUST install curl/wget BEFORE trying to self-update.
install_minimal_deps() {
    step_header "Installing Minimal Dependencies"
    
    log_msg "Updating package lists..."
    apt-get update -y
    
    MINIMAL_PACKAGES="curl wget"
    log_msg "Installing $MINIMAL_PACKAGES to enable self-update..."
    apt-get install -y --no-install-recommends $MINIMAL_PACKAGES
    
    # Verify they work
    if ! command -v curl &>/dev/null || ! command -v wget &>/dev/null; then
        log_error "Failed to install curl or wget. Cannot proceed."
        exit 1
    fi
    
    log_msg "Minimal dependencies ready."
}

# --- Step 0.5: SELF-UPDATE CHECK (Now safe) ---
check_self_update() {
    local temp_file="/tmp/udc_setup_update_$$_$(date +%s)"
    
    log_msg "Checking for script updates from GitHub..."
    
    # Download potential update
    if ! curl -sSL "$SCRIPT_URL" -o "$temp_file"; then
        log_msg "Failed to download update from GitHub. Continuing with current version."
        rm -f "$temp_file"
        return 1
    fi

    # Validate downloaded content
    if ! head -n 1 "$temp_file" | grep -q "^#!"; then
        log_msg "Downloaded content is not a valid script. Skipping update."
        rm -f "$temp_file"
        return 1
    fi

    # Compare current script with downloaded one
    if diff -q "$0" "$temp_file" > /dev/null 2>&1; then
        log_msg "Script is up to date."
        rm -f "$temp_file"
        return 0
    else
        log_msg "New version detected! Backing up and updating..."
        
        # Backup current script
        local backup_name="${0}.bak.$(date +%s)"
        cp "$0" "$backup_name"
        log_msg "Backup created: $backup_name"
        
        # Replace current script with new one
        mv "$temp_file" "$0"
        chmod +x "$0"
        
        log_msg "Script updated successfully. Restarting with new version..."
        # Execute the NEW script with all original arguments
        exec "$0" "$@"
        exit 0
    fi
}

# --- Step 1: Full System Preparation ---
prepare_system() {
    step_header "System Preparation"
    
    log_msg "Creating log directories..."
    mkdir -p "$UDC_DIR" "$RKHUNTER_DIR" "$CLAMAV_DIR" "$ERROR_DIR"
    chown -R root:root "$LOG_BASE"
    chmod -R 755 "$LOG_BASE"

    REQUIRED_PACKAGES="clamav clamav-daemon freshclam rkhunter deborphan ntpdate unzip"
    log_msg "Installing full suite of packages: $REQUIRED_PACKAGES..."
    apt-get install -y $REQUIRED_PACKAGES

    log_msg "Configuring ClamAV..."
    # Stop background service to prevent lock conflicts
    if systemctl is-active --quiet clamav-freshclam 2>/dev/null; then
        systemctl stop clamav-freshclam
        systemctl disable clamav-freshclam
        log_msg "clamav-freshclam service disabled."
    elif [ -f /etc/init.d/clamav-freshclam ]; then
        /etc/init.d/clamav-freshclam stop
    fi
    
    # Remove stale lock file
    rm -f /var/lib/clamav/freshclam.lock
    log_msg "Stale ClamAV lock file removed if present."

    log_msg "Running initial ClamAV database update..."
    freshclam || log_error "Initial freshclam update failed."

    log_msg "Configuring RKhunter..."
    rkhunter --update || true
    rkhunter --propupd || true

    log_msg "Verifying installation..."
    MISSING=""
    for cmd in clamscan freshclam rkhunter deborphan ntpdate curl wget; do
        command -v $cmd &>/dev/null || MISSING="$MISSING $cmd"
    done
    
    if [ -n "$MISSING" ]; then
        log_error "Missing tools: $MISSING. Setup incomplete."
        exit 1
    fi
    log_msg "System preparation complete."
}

# --- Step 2: User Selection (Two Menus) ---
select_script() {
    step_header "Select Environment Type"
    echo "Which type of computer is this?"
    echo "1. Desktop/PC with BIOS Scheduled Wakeup (Shuts down after update)"
    echo "   -> Uses Option A Menu below"
    echo "2. Server/Always-On Machine (Never shuts down automatically)"
    echo "   -> Uses Option B Menu below"
    echo ""
    read -p "Enter choice (1 or 2): " ENV_CHOICE

    case $ENV_CHOICE in
        1)
            select_submenu_a
            ;;
        2)
            select_submenu_b
            ;;
        *)
            log_error "Invalid environment selection."
            exit 1
            ;;
    esac
}

select_submenu_a() {
    step_header "Option A: BIOS Wakeup Selection"
    echo "Available Scripts:"
    echo "1. updateandcleandaily (Shuts down PC at end - Requires 1:45 AM BIOS Wakeup)"
    echo "2. updateandclean (Runs daily but keeps PC ON)"
    echo "3. INSTALL BOTH (Installs both scripts above)"
    echo ""
    read -p "Enter choice (1, 2, or 3): " CHOICE

    case $CHOICE in
        1)
            SCRIPT_NAMES=("updateandcleandaily")
            URLs=("$URL_DAILY_SHUTDOWN")
            CRON_TYPES=("daily_shutdown")
            ;;
        2)
            SCRIPT_NAMES=("updateandclean")
            URLs=("$URL_REGULAR")
            CRON_TYPES=("regular_wakeon")
            ;;
        3)
            SCRIPT_NAMES=("updateandcleandaily" "updateandclean")
            URLs=("$URL_DAILY_SHUTDOWN" "$URL_REGULAR")
            CRON_TYPES=("daily_shutdown" "regular_wakeon")
            log_msg "You selected to install BOTH scripts."
            ;;
        *)
            log_error "Invalid selection."
            exit 1
            ;;
    esac
}

select_submenu_b() {
    step_header "Option B: Server/Plex Selection"
    echo "Available Scripts:"
    echo "1. updateandclean (Standard Daily Maintenance)"
    echo "2. updateandclean-PLEX (Plex Specific Maintenance)"
    echo "3. INSTALL BOTH (Installs both scripts above)"
    echo ""
    read -p "Enter choice (1, 2, or 3): " CHOICE

    case $CHOICE in
        1)
            SCRIPT_NAMES=("updateandclean")
            URLs=("$URL_REGULAR")
            CRON_TYPES=("regular")
            ;;
        2)
            SCRIPT_NAMES=("updateandclean-PLEX")
            URLs=("$URL_PLEX")
            CRON_TYPES=("plex")
            ;;
        3)
            SCRIPT_NAMES=("updateandclean" "updateandclean-PLEX")
            URLs=("$URL_REGULAR" "$URL_PLEX")
            CRON_TYPES=("regular" "plex")
            log_msg "You selected to install BOTH scripts."
            ;;
        *)
            log_error "Invalid selection."
            exit 1
            ;;
    esac
}

# --- Step 3: Download & Install (Multi-Script Support) ---
install_scripts() {
    step_header "Downloading and Installing Script(s)"
    
    local TOTAL=${#SCRIPT_NAMES[@]}
    local CURRENT=0

    # Check Internet connectivity
    log_msg "Checking internet connectivity..."
    if ! ping -c 3 -W 5 github.com &>/dev/null; then
        log_error "No internet connection detected. Cannot download scripts."
        exit 1
    fi

    for i in "${!SCRIPT_NAMES[@]}"; do
        CURRENT=$((CURRENT + 1))
        local NAME="${SCRIPT_NAMES[$i]}"
        local URL="${URLS[$i]}"
        local DEST="$INSTALL_PATH/$NAME"
        
        log_msg "--- Installing Script $CURRENT of $TOTAL: $NAME ---"
        
        # Backup existing file
        if [ -f "$DEST" ]; then
            log_msg "Existing installation found. Backing up to ${DEST}.bak.$(date +%s)..."
            mv "$DEST" "${DEST}.bak.$(date +%s)"
        fi

        log_msg "Downloading $NAME from GitHub..."
        if ! curl -sSL "$URL" -o "$DEST"; then
            log_error "Failed to download script from $URL"
            continue
        fi

        # Validate Content
        if ! head -n 1 "$DEST" | grep -q "^#!"; then
            log_error "Downloaded content is not a valid script. Skipping."
            rm -f "$DEST"
            continue
        fi

        chmod +x "$DEST"
        log_msg "Script installed to: $DEST"
        log_msg "Made executable."
    done
    
    DEST_PATH="$INSTALL_PATH/${SCRIPT_NAMES[0]}"
    log_msg "All script downloads completed."
}

# --- Step 4: Cron Configuration ---
setup_cron() {
    step_header "Configuring Cron Job(s)"
    
    log_msg "Cleaning up old UDC cron jobs..."
    crontab -l 2>/dev/null | grep -v "updateandclean" | grep -v "updateandcleandaily" | grep -v "updateandclean-PLEX" | crontab - || true
    
    local TIME="02:00"
    local HAS_CRON=false

    for i in "${!SCRIPT_NAMES[@]}"; do
        local NAME="${SCRIPT_NAMES[$i]}"
        local TYPE="${CRON_TYPES[$i]}"
        local COMMAND="$INSTALL_PATH/$NAME >> $UDC_DIR/cron.log 2>&1"
        
        if [ "$TYPE" != "regular" ] && [ "$TYPE" != "regular_wakeon" ]; then
            log_msg "Adding cron job for $NAME at $TIME every day..."
            (crontab -l 2>/dev/null | grep -v "$NAME"; echo "$TIME * * * * $COMMAND") | crontab -
            HAS_CRON=true
        else
            log_msg "No auto-cron for $NAME (Manual mode)."
        fi
    done
    
    if [ "$HAS_CRON" = true ]; then
        log_msg "Cron job(s) added successfully."
    fi
    
    for TYPE in "${CRON_TYPES[@]}"; do
        if [ "$TYPE" == "daily_shutdown" ]; then
            echo ""
            echo "⚠️  IMPORTANT REMINDER ⚠️"
            echo "You have 'updateandcleandaily' installed. Set BIOS RTC Alarm/Wake Time to: ** 01:45 AM **"
            echo ""
            break
        fi
    done
}

# --- Step 5: Optional Execution ---
run_now() {
    step_header "Run Script Now?"
    
    echo "Available installed scripts:"
    for i in "${!SCRIPT_NAMES[@]}"; do
        echo "  $((i+1)). ${SCRIPT_NAMES[$i]}"
    done
    echo "  0. Skip (do not run now)"
    echo ""
    
    if [[ " ${SCRIPT_NAMES[*]} " =~ " updateandcleandaily " ]]; then
        echo "⛔ SAFETY WARNING ⛔"
        echo "One of your scripts ('updateandcleandaily') WILL SHUT DOWN your computer."
        echo ""
        read -p "Do you want to run updateandcleandaily now? Type 'YES' to confirm: " CONFIRM
        if [[ "$CONFIRM" == "YES" ]]; then
            log_msg "Starting updateandcleandaily..."
            "$INSTALL_PATH/updateandcleandaily"
            EXIT_CODE=$?
            if [ $EXIT_CODE -eq 0 ]; then
                log_msg "updateandcleandaily launched successfully."
            else
                log_error "updateandcleandaily exited with code $EXIT_CODE."
            fi
            log_msg "Exiting setup script after shutdown launch."
            exit 0
        else
            log_msg "Skipping updateandcleandaily execution."
        fi
    fi
    
    if [ ${#SCRIPT_NAMES[@]} -gt 0 ]; then
        read -p "Do you want to run any other installed script immediately? (y/n): " RUN_NOW
        if [[ "$RUN_NOW" =~ ^[Yy]$ ]]; then
            for NAME in "${SCRIPT_NAMES[@]}"; do
                if [ "$NAME" != "updateandcleandaily" ]; then
                    log_msg "Starting $NAME..."
                    "$INSTALL_PATH/$NAME"
                    EXIT_CODE=$?
                    if [ $EXIT_CODE -eq 0 ]; then
                        log_msg "$NAME completed successfully."
                    else
                        log_error "$NAME exited with code $EXIT_CODE."
                    fi
                fi
            done
        else
            log_msg "Skipping immediate execution."
        fi
    fi
}

# --- Final Summary ---
final_report() {
    step_header "Setup Complete"
    
    log_msg "Checking system timezone..."
    CURRENT_TZ=$(timedatectl 2>/dev/null | grep "Time zone" | awk '{print $3}')
    if [[ "$CURRENT_TZ" == "UTC" ]]; then
        log_msg "⚠️ WARNING: System timezone is UTC."
        echo "   Your 2 AM cron jobs will run at 2 AM UTC, NOT your local time."
        echo "   To fix: timedatectl set-timezone <Your_Timezone>"
        echo ""
    fi
    
    echo ""
    echo "Summary of actions performed:"
    echo "1. ✅ System directories created ($LOG_BASE)."
    echo "2. ✅ Tools installed (ClamAV, RKhunter, etc.)."
    echo "3. ✅ Script(s) installed to $INSTALL_PATH:"
    for NAME in "${SCRIPT_NAMES[@]}"; do
        echo "     - $NAME"
    done
    
    for TYPE in "${CRON_TYPES[@]}"; do
        if [ "$TYPE" == "daily_shutdown" ] || [ "$TYPE" == "plex" ]; then
            echo "4. ✅ Cron job(s) scheduled for 02:00 AM daily."
            break
        fi
    done
    
    if [[ " ${CRON_TYPES[*]} " =~ " daily_shutdown " ]]; then
        echo "5. ⚠️  REMEMBER: Set BIOS Wake-up time to 01:45 AM!"
    fi
    
    echo ""
    echo "📝 Full setup log saved to: $SETUP_LOG"
    echo "Logs stored in: $LOG_BASE"
    echo "To run manually anytime: sudo $INSTALL_PATH/<script_name>"
    echo ""
    echo "🎉 All tasks completed successfully!"
    echo ""
}

# --- Cleanup Old Backups ---
cleanup_old_backups() {
    log_msg "Cleaning up old script backups (>30 days)..."
    find /usr/bin -maxdepth 1 -name "*.bak.*" -mtime +30 -delete 2>/dev/null || true
    log_msg "Old backup cleanup complete."
}

# --- Main Execution Flow ---
check_root
install_minimal_deps  # FIX: Install curl/wget FIRST
check_self_update     # NOW SAFE to use curl
prepare_system
select_script
install_scripts
cleanup_old_backups
setup_cron
run_now
final_report
