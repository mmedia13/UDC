#!/bin/bash
# UDC-SETUP v2.5 - Self-Updating Master Script (Updates Current File Path)
# Features: Auto-Update (replaces current file), Proper Repo/Update Sequence, Resilient Error Handling
# URL: https://raw.githubusercontent.com/mmedia13/UDC/refs/heads/main/UDC-Setup-Current

# --- Configuration ---
LOG_BASE="/home/logs"
UDC_DIR="$LOG_BASE/UDC"
mkdir -p "$UDC_DIR"
SETUP_LOG="$UDC_DIR/SETUP.log"
SCRIPT_URL="https://raw.githubusercontent.com/mmedia13/UDC/refs/heads/main/UDC-Setup-Current"

# Enable logging to file immediately
exec > >(tee -a "$SETUP_LOG") 2>&1

# Remove 'set -e' to handle errors gracefully
# set -e 

# --- Helper Functions ---

log_msg() { echo "[INFO] $(date '+%T'): $1"; }
log_error() { echo "[ERROR] $(date '+%T'): $1" >&2; }
log_warning() { echo "[WARNING] $(date '+%T'): $1"; }

check_root() {
    if [ "$EUID" -ne 0 ]; then
        log_error "This script must be run as root (sudo)."
        echo "Please run: sudo ./UDC-SETUP"
        exit 1
    fi
}

step_header() {
    echo ""
    echo "=========================================="
    echo "      $1"
    echo "=========================================="
}

# --- Step 0: Minimal Dependency Install ---
install_minimal_deps() {
    step_header "Installing Minimal Dependencies"
    
    log_msg "Updating package lists for basic tools..."
    apt-get update -y || log_error "Failed to update package lists initially."
    
    MINIMAL_PACKAGES="curl wget software-properties-common gnupg2" 
    log_msg "Installing $MINIMAL_PACKAGES..."
    apt-get install -y --no-install-recommends $MINIMAL_PACKAGES
    
    if ! command -v curl &>/dev/null || ! command -v wget &>/dev/null; then
        log_error "CRITICAL: Failed to install curl or wget. Cannot proceed."
        exit 1
    fi
    
    log_msg "Minimal dependencies ready."
}

# --- Step 0.5: SELF-UPDATE CHECK (Replaces Current File) ---
check_self_update() {
    local temp_file="/tmp/udc_setup_update_$$_$(date +%s)"
    local current_script_path="$0" # Stores the full path of the running script

    log_msg "Checking for script updates from GitHub..."
    log_msg "Current script location: $current_script_path"
    
    # Download potential update
    if ! curl -sSL "$SCRIPT_URL" -o "$temp_file"; then
        log_msg "Failed to download update from GitHub. Continuing with current version."
        rm -f "$temp_file"
        return 1
    fi

    # Validate downloaded content
    if ! head -n 1 "$temp_file" | grep -q "^#!"; then
        log_msg "Downloaded content is not a valid script. Skipping update."
        rm -f "$temp_file"
        return 1
    fi

    # Compare current script with downloaded one
    if diff -q "$current_script_path" "$temp_file" > /dev/null 2>&1; then
        log_msg "Script is up to date at: $current_script_path"
        rm -f "$temp_file"
        return 0
    else
        log_msg "New version detected! Backing up and updating CURRENT file: $current_script_path..."
        
        # Backup current script
        local backup_name="${current_script_path}.bak.$(date +%s)"
        cp "$current_script_path" "$backup_name"
        log_msg "Backup created: $backup_name"
        
        # Move new version over the CURRENT running file path
        if mv "$temp_file" "$current_script_path"; then
            chmod +x "$current_script_path"
            log_msg "Successfully replaced the old version with the new one at: $current_script_path"
            
            # Execute the NEW file immediately (this replaces the running process)
            log_msg "Restarting execution with the new version..."
            exec "$current_script_path" "$@"
            exit 0
        else
            log_error "CRITICAL: Failed to overwrite the current script file. Aborting."
            log_error "You may need to manually replace '$current_script_path'."
            rm -f "$temp_file"
            return 1
        fi
    fi
}

# --- Step 1: Full System Preparation ---
prepare_system() {
    step_header "System Preparation"
    
    log_msg "Creating log directories..."
    mkdir -p "$UDC_DIR" "$RKHUNTER_DIR" "$CLAMAV_DIR" "$ERROR_DIR"
    chown -R root:root "$LOG_BASE"
    chmod -R 755 "$LOG_BASE"

    # 1. ADD REPOSITORY FIRST
    log_msg "Enabling 'universe' repository (Required for ClamAV/RKhunter)..."
    add-apt-repository universe -y >> "$SETUP_LOG" 2>&1 || log_warning "Could not add universe repo."

    # 2. UPDATE IMMEDIATELY AFTER ADDING REPO (CRITICAL FIX)
    log_msg "Running apt-get update to refresh package lists..."
    if ! apt-get update -y; then
        log_error "CRITICAL: Failed to update package lists."
        exit 1
    fi

    # 3. NOW INSTALL PACKAGES
    REQUIRED_PACKAGES="clamav clamav-daemon freshclam rkhunter deborphan ntpdate unzip"
    log_msg "Installing full suite of packages: $REQUIRED_PACKAGES..."
    
    if ! apt-get install -y $REQUIRED_PACKAGES; then
        log_error "CRITICAL: Failed to install essential security packages."
        log_error "Check logs at $SETUP_LOG."
    fi

    # Verify critical tools
    MISSING=""
    for cmd in clamscan freshclam rkhunter deborphan ntpdate curl wget; do
        command -v $cmd &>/dev/null || MISSING="$MISSING $cmd"
    done
    
    if [ -n "$MISSING" ]; then
        log_error "⚠️ WARNING: Some tools are missing: $MISSING."
    else
        log_msg "All critical tools verified."
        
        log_msg "Configuring ClamAV..."
        if systemctl is-active --quiet clamav-freshclam 2>/dev/null; then
            systemctl stop clamav-freshclam
            systemctl disable clamav-freshclam
            log_msg "clamav-freshclam service disabled."
        elif [ -f /etc/init.d/clamav-freshclam ]; then
            /etc/init.d/clamav-freshclam stop
        fi
        
        rm -f /var/lib/clamav/freshclam.lock
        log_msg "Running initial ClamAV database update..."
        freshclam || log_error "Initial freshclam update failed."

        log_msg "Configuring RKhunter..."
        rkhunter --update || true
        rkhunter --propupd || true
    fi
    
    log_msg "System preparation phase complete."
}

# --- Step 2: User Selection ---
select_script() {
    step_header "Select Environment Type"
    echo "Which type of computer is this?"
    echo "1. Desktop/PC with BIOS Scheduled Wakeup (Shuts down after update)"
    echo "   -> Uses Option A Menu below"
    echo "2. Server/Always-On Machine (Never shuts down automatically)"
    echo "   -> Uses Option B Menu below"
    echo ""
    read -p "Enter choice (1 or 2): " ENV_CHOICE

    case $ENV_CHOICE in
        1) select_submenu_a ;;
        2) select_submenu_b ;;
        *) log_error "Invalid environment selection."; exit 1 ;;
    esac
}

select_submenu_a() {
    step_header "Option A: BIOS Wakeup Selection"
    echo "1. updateandcleandaily (Shuts down PC - Requires 1:45 AM BIOS Wakeup)"
    echo "2. updateandclean (Runs daily, keeps PC ON)"
    echo "3. INSTALL BOTH"
    echo ""
    read -p "Enter choice (1, 2, or 3): " CHOICE
    case $CHOICE in
        1) SCRIPT_NAMES=("updateandcleandaily"); URLs=("$URL_DAILY_SHUTDOWN"); CRON_TYPES=("daily_shutdown") ;;
        2) SCRIPT_NAMES=("updateandclean"); URLs=("$URL_REGULAR"); CRON_TYPES=("regular_wakeon") ;;
        3) SCRIPT_NAMES=("updateandcleandaily" "updateandclean"); URLs=("$URL_DAILY_SHUTDOWN" "$URL_REGULAR"); CRON_TYPES=("daily_shutdown" "regular_wakeon") ;;
        *) log_error "Invalid selection."; exit 1 ;;
    esac
}

select_submenu_b() {
    step_header "Option B: Server/Plex Selection"
    echo "1. updateandclean (Standard)"
    echo "2. updateandclean-PLEX (Plex)"
    echo "3. INSTALL BOTH"
    echo ""
    read -p "Enter choice (1, 2, or 3): " CHOICE
    case $CHOICE in
        1) SCRIPT_NAMES=("updateandclean"); URLs=("$URL_REGULAR"); CRON_TYPES=("regular") ;;
        2) SCRIPT_NAMES=("updateandclean-PLEX"); URLs=("$URL_PLEX"); CRON_TYPES=("plex") ;;
        3) SCRIPT_NAMES=("updateandclean" "updateandclean-PLEX"); URLs=("$URL_REGULAR" "$URL_PLEX"); CRON_TYPES=("regular" "plex") ;;
        *) log_error "Invalid selection."; exit 1 ;;
    esac
}

# --- Step 3: Download & Install Scripts ---
install_scripts() {
    step_header "Downloading and Installing Script(s)"
    local TOTAL=${#SCRIPT_NAMES[@]}
    
    log_msg "Checking internet connectivity..."
    if ! ping -c 3 -W 5 github.com &>/dev/null; then
        log_error "No internet connection detected."
        exit 1
    fi

    for i in "${!SCRIPT_NAMES[@]}"; do
        local NAME="${SCRIPT_NAMES[$i]}"
        local URL="${URLS[$i]}"
        local DEST="$INSTALL_PATH/$NAME"
        log_msg "--- Installing $NAME ---"
        
        if [ -f "$DEST" ]; then
            mv "$DEST" "${DEST}.bak.$(date +%s)"
            log_msg "Backed up existing file."
        fi

        if ! curl -sSL "$URL" -o "$DEST"; then
            log_error "Failed to download $NAME."
            continue
        fi

        if ! head -n 1 "$DEST" | grep -q "^#!"; then
            log_error "Invalid script downloaded ($NAME). Skipping."
            rm -f "$DEST"
            continue
        fi

        chmod +x "$DEST"
        log_msg "$NAME installed."
    done
    DEST_PATH="$INSTALL_PATH/${SCRIPT_NAMES[0]}"
}

# --- Step 4: Cron Configuration ---
setup_cron() {
    step_header "Configuring Cron Job(s)"
    crontab -l 2>/dev/null | grep -v "updateandclean" | grep -v "updateandcleandaily" | grep -v "updateandclean-PLEX" | crontab - || true
    
    local TIME="02:00"
    local HAS_CRON=false
    for i in "${!SCRIPT_NAMES[@]}"; do
        local NAME="${SCRIPT_NAMES[$i]}"
        local TYPE="${CRON_TYPES[$i]}"
        local COMMAND="$INSTALL_PATH/$NAME >> $UDC_DIR/cron.log 2>&1"
        
        if [ "$TYPE" != "regular" ] && [ "$TYPE" != "regular_wakeon" ]; then
            (crontab -l 2>/dev/null | grep -v "$NAME"; echo "$TIME * * * * $COMMAND") | crontab -
            HAS_CRON=true
        fi
    done
    
    if [ "$HAS_CRON" = true ]; then
        log_msg "Cron jobs added."
    fi
    
    if [[ " ${CRON_TYPES[*]} " =~ " daily_shutdown " ]]; then
        echo ""
        echo "⚠️  IMPORTANT REMINDER ⚠️"
        echo "Set BIOS RTC Alarm/Wake Time to: ** 01:45 AM **"
        echo ""
    fi
}

# --- Step 5: Optional Execution ---
run_now() {
    step_header "Run Script Now?"
    echo "Available scripts:"
    for i in "${!SCRIPT_NAMES[@]}"; do echo "  $((i+1)). ${SCRIPT_NAMES[$i]}"; done
    echo "  0. Skip"
    echo ""
    
    if [[ " ${SCRIPT_NAMES[*]} " =~ " updateandcleandaily " ]]; then
        echo "⛔ SAFETY: Running 'updateandcleandaily' will SHUT DOWN this machine."
        read -p "Type 'YES' to confirm: " CONFIRM
        if [[ "$CONFIRM" == "YES" ]]; then
            "$INSTALL_PATH/updateandcleandaily"
            exit 0
        fi
    fi
    
    read -p "Run other scripts now? (y/n): " RUN_NOW
    if [[ "$RUN_NOW" =~ ^[Yy]$ ]]; then
        for NAME in "${SCRIPT_NAMES[@]}"; do
            if [ "$NAME" != "updateandcleandaily" ]; then
                "$INSTALL_PATH/$NAME"
            fi
        done
    fi
}

# --- Final Summary ---
final_report() {
    step_header "Setup Complete"
    CURRENT_TZ=$(timedatectl 2>/dev/null | grep "Time zone" | awk '{print $3}')
    if [[ "$CURRENT_TZ" == "UTC" ]]; then
        echo "⚠️ WARNING: System timezone is UTC. Cron runs at UTC time."
    fi
    
    echo "Scripts installed: ${SCRIPT_NAMES[*]}"
    echo "Logs: $LOG_BASE"
    echo "🎉 Setup finished!"
}

cleanup_old_backups() {
    find /usr/bin -maxdepth 1 -name "*.bak.*" -mtime +30 -delete 2>/dev/null || true
}

# --- Main Flow ---
check_root
install_minimal_deps
check_self_update  # <-- NOW REPLACES THE CURRENT FILE PATH
prepare_system
select_script
install_scripts
cleanup_old_backups
setup_cron
run_now
final_report
